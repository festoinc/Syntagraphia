{
  "name": "syntagraphia",
  "version": "2026.08.08-2",
  "description": "Structured, connected project docs (features, specs, tasks, verifications) in a local SQLite DB — for humans and AI agents.",
  "license": "MIT",
  "author": "Anatolii Fesiuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/festoinc/Syntagraphia.git"
  },
  "homepage": "https://github.com/festoinc/Syntagraphia#readme",
  "keywords": [
    "docs",
    "documentation",
    "ai-agent",
    "agent",
    "sqlite",
    "cli",
    "feature-tracking"
  ],
  "bin": {
    "syntagraphia": "bin/syntagraphia.js"
  },
  "files": [
    "bin",
    "lib",
    "schema.sql",
    "schema.postgres.sql",
    "AGENTS_template.md",
    "templates",
    "ui/dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "server": "node bin/syntagraphia.js ui --no-open",
    "client": "cd ui && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:ui": "cd ui && npm install && npm run build",
    "prepack": "npm run build:ui",
    "prepublishOnly": "npm run build:ui"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
